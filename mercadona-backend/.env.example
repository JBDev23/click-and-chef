# Docker Compose reads this file after copying it to .env.
# For Spring Boot outside Docker, export the same values in the terminal/IDE.
DB_USERNAME=postgres
DB_PASSWORD=root
POSTGRES_DB=mercadona_db
POSTGRES_PORT=5441
DB_URL=jdbc:postgresql://localhost:5441/mercadona_db
SERVER_PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081
